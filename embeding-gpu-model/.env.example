# ── Rocky Legal GPU Embedding Server Configuration ───────────────

# Optional API Key for securing the GPU server (recommended for cloud servers)
# If left blank, server is open without authentication
API_KEY=

# Batch size for parallel GPU encoding (32 is ideal for 16GB T4; 64 for 24GB L4)
BATCH_SIZE=32

# Port to expose on the host
PORT=8000
